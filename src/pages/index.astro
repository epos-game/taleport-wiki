---
// Starlight puts every page under a locale, so the site root has no page of its own and answered
// with a 404. This sends a reader on to a language instead. Czech is where they land, because that
// is who writes on TalePort; a browser asking for English gets English. The paths are relative so
// the same page works on localhost, on a staging host and in production.
const LANDING = 'cs';
const ALTERNATE = 'en';

// Resolved against this page's own URL, so a site served from a sub-path keeps its prefix whether or
// not its configured base ends in a slash.
const toLanguage = (code: string) => new URL(`${code}/`, Astro.url).pathname;
const landing = toLanguage(LANDING);
const alternate = toLanguage(ALTERNATE);
---

<html lang={LANDING}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>TalePort</title>
    <link rel="canonical" href={landing} />
    <script is:inline define:vars={{ landing, alternate, alternateCode: ALTERNATE }}>
      const asked = (navigator.language || '').slice(0, 2);
      location.replace(asked === alternateCode ? alternate : landing);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${landing}`} /></noscript>
  </head>
  <body>
    <p>
      <a href={landing}>Dokumentace TalePort</a>
      &middot;
      <a href={alternate}>TalePort documentation</a>
    </p>
  </body>
</html>
