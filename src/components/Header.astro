---
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

import Brand from './Brand.astro';
import LanguageSelect from './LanguageSelect.astro';

// Starlight reaches its own components through `virtual:starlight/components/*`, which applies any
// override configured for them. This file is the override, so it imports what it renders directly;
// the virtual modules ship no type declarations and would fail `astro check`.

// The wordmark lives at the head of the sidebar. A page without one (the 404, or anything on the
// splash template) would otherwise be unbranded, so on those the bar carries it at every size.
const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class:list={['tp-header', { 'tp-header--unrailed': !hasSidebar }]}>
  <Brand class={hasSidebar ? 'header__brand' : 'header__brand header__brand--unrailed'} />
  <div class="header__search print:hidden"><Search /></div>
  <div class="header__actions print:hidden">
    <div class="social-icons"><SocialIcons /></div>
    <LanguageSelect />
  </div>
</div>

<script>
  // A link to the page you are already on still triggers a full reload, which costs a round trip
  // and repaints the window for nothing. Covers the sidebar entry and the language toggle alike.
  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const target = event.target;
    const link = target instanceof Element ? target.closest('a[href]') : null;
    if (!(link instanceof HTMLAnchorElement)) return;
    if (link.target || link.href !== location.href) return;

    event.preventDefault();

    const pane = document.getElementById('starlight__sidebar');
    if (pane?.matches(':popover-open')) pane.hidePopover();

    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
