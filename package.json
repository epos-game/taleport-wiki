    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": ">=22.12.0"
