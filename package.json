{
  "name": "taleport-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Author-facing documentation for TalePort. Source of truth for the Content Rules.",
  "scripts": {
    "dev": "npm run assets && astro dev",
    "build": "npm run assets && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "audit": "npm run build && node scripts/audit.mjs",
    "diagrams": "node scripts/build-diagrams.mjs",
    "assets": "npm run diagrams && npm run sizes && npm run images",
    "sizes": "node scripts/screenshot-sizes.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.13",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.18.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
